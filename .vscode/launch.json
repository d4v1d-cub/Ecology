{
    "configurations": [
        {
            "name": "C/C++: g++ IBMF sequential",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/Debug/IBMF_LV_sequential.out",
            "args": [//"--print_params",
                     "--avn_0", "0.5", 
                     "--random_init", "0.5", "1", "2",
                     "--temp", "0.001", 
                     "--lambda", "1e-6", 
                     "--tol", "1e-6", 
                     "--max_iter", "10000", 
                     "--seed_seq", "1", 
                     "--num_seq", "1", 
                     "--tol_fp", "1e-2", 
                     "--damping", "0.2",
                    //  "--print_avgs",
                     "--print_only_last",
                     "--gr_inside",
                     "--eps", "0.0", 
                     "--mu", "0.300", 
                     "--sigma", "0.000",
                     "--seed_graph", "1", 
                     "-N", "4096", 
                     "-c", "3",
                     "--graph_type", "RRG"
                    ],
            "stopAtEntry": false,
            "cwd": "${fileDirname}/Debug",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: g++ IBMF sequential",
            "miDebuggerPath": "/usr/bin/gdb"
        },
